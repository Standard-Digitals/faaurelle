# Public URL configuration. Leave empty when serving at the domain root.
NEXT_PUBLIC_BASE_PATH=

# Brevo transactional SMTP configuration.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-your-brevo-smtp-login
SMTP_PASS=replace-with-your-brevo-smtp-key

# Use the authenticated mailbox as From. Visitor email is applied as Reply-To.
SMTP_FROM=support@faaurelle.com
SUBSCRIPTION_TO_EMAIL=support@faaurelle.com
