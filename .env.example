# Local development template. Copy the needed values to an ignored .env file.
# For Vercel Preview/Production configuration, use .env.prod.example instead.

# Public URL configuration. Leave empty when serving locally at the domain root.
NEXT_PUBLIC_BASE_PATH=

# Local Docker PostgreSQL configuration. These POSTGRES_* variables are consumed
# only by compose.yaml and are not required in Vercel.
POSTGRES_DB=fa_aurelle
POSTGRES_USER=fa_aurelle
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_PORT=5432

# Server-only Prisma connection used by the host-running Next.js application.
# Keep the credentials in sync with the local POSTGRES_* values above.
DATABASE_URL=postgresql://fa_aurelle:replace-with-a-local-development-password@localhost:5432/fa_aurelle?schema=public

# Server-only Delhivery B2C serviceability configuration.
# Staging: https://staging-express.delhivery.com
# Production: https://track.delhivery.com (use the matching production token).
DELHIVERY_API_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_API_TOKEN=replace-with-your-delhivery-staging-token

# Razorpay Test Mode is supported in Preview and Production runtimes.
# Any value other than the exact literal `test` is rejected; Live Mode remains disabled.
RAZORPAY_PAYMENT_MODE=test
RAZORPAY_KEY_ID=replace-with-your-razorpay-test-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-dedicated-razorpay-test-webhook-secret

# Brevo transactional SMTP configuration.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-your-brevo-smtp-login
SMTP_PASS=replace-with-your-brevo-smtp-key

# Use the authenticated mailbox as From. Visitor email is applied as Reply-To.
SMTP_FROM=support@example.com
SUBSCRIPTION_TO_EMAIL=support@example.com
