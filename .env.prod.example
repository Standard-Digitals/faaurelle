# Vercel Preview / Production environment template.
# Add real values directly in Vercel Project Settings; never commit credentials.
# Preview and Production may use different managed database and provider accounts.

# Managed PostgreSQL connection used by both Prisma CLI and the application runtime.
# Set this from the managed PostgreSQL provider for each Vercel environment.
DATABASE_URL=replace-with-managed-postgres-url

# Public URL configuration. Leave empty when deployed at the domain root.
NEXT_PUBLIC_BASE_PATH=

# Delhivery server-only configuration.
# Production values. Use staging credentials only in Vercel Preview.
DELHIVERY_API_BASE_URL=https://track.delhivery.com
DELHIVERY_API_TOKEN=replace-with-live-delhivery-api-token
DELHIVERY_PICKUP_NAME=replace-with-exact-production-registered-pickup-name
COMMERCE_DEBUG_LOGS=false

# Razorpay server-only configuration.
# Mode is explicit and independent of NODE_ENV. Production must use matching
# Live credentials and webhook secret; there is no fallback to Test credentials.
RAZORPAY_PAYMENT_MODE=live
RAZORPAY_KEY_ID=replace-with-live-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-live-razorpay-key-secret
# Must match the webhook secret configured in the corresponding Dashboard environment.
RAZORPAY_WEBHOOK_SECRET=replace-with-live-razorpay-webhook-secret

# SMTP / transactional email server configuration.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-login
SMTP_PASS=replace-with-smtp-key
SMTP_FROM=support@example.com
SUBSCRIPTION_TO_EMAIL=support@example.com
# Optional contact-form recipient. Falls back to SUBSCRIPTION_TO_EMAIL, then SMTP_FROM.
CONTACT_TO_EMAIL=support@example.com

# The Vercel/Prisma integration may additionally provide PRISMA_DATABASE_URL and
# POSTGRES_URL. Current repository code does not consume either variable; DATABASE_URL
# remains required. Do not add Docker-only POSTGRES_DB/USER/PASSWORD/PORT here.
